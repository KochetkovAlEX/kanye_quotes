<header class="header">
  <button class="header__btn">Ещё цитата</button>
</header>

<main class="container">
  <section class="quote-section">
    <div class="quote">
      Sometimes you have to get rid of everything
    </div>

    <div class="save-btn_container">
      <button class="save-btn">Сохранить фразу</button>
    </div>
  </section>
  
  <div class="saved-section">
    <h3 class="saved-section__title">Ваша коллекция:</h3>

    <ul id="quotes-list" class="saved-list">
      <% @quotes.each do |quote| %>
        <li class="saved-list__item" data-id="<%= quote.id %>">
          <span class="saved-list__text"><%= quote.text %></span>
          <button class="delete-btn">Удалить</button>
        </li>
      <% end %>
    </ul>
  </div>
</main>