<h1>Вход в систему</h1>

<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>

<%= form_with url: login_path, method: :post, local: true do |form| %>
  <div>
    <%= label_tag :name, 'Имя пользователя' %>
    <%= text_field_tag :name, params[:name], required: true %>
  </div>

  <div>
    <%= label_tag :password, 'Пароль' %>
    <%= password_field_tag :password, nil, required: true %>
  </div>

  <%= submit_tag 'Войти' %>
<% end %>

<p>Нет аккаунта? <%= link_to 'Зарегистрироваться', signup_path %></p>