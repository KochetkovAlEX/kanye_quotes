<h1>Регистрация нового аккаунта</h1>

<%= form_with model: @user, url: signup_path, local: true do |form| %>
  <% if @user.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@user.errors.count, "ошибка") %>:</h2>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, "Имя пользователя" %>
    <%= form.text_field :name, required: true %>
  </div>

  <div>
    <%= form.label :password, "Пароль" %>
    <%= form.password_field :password, required: true %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Подтверждение пароля" %>
    <%= form.password_field :password_confirmation, required: true %>
  </div>

  <%= form.submit "Создать аккаунт" %>
<% end %>

<p>Уже зарегистрированы? <%= link_to "Войти", login_path %></p>