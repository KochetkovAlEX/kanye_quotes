<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">Регистрация нового аккаунта</h1>

    <%= form_with model: @user, url: signup_path, local: true do |form| %>
      <div class="auth-form-group">
        <%= form.label :name, "Имя пользователя" %>
        <%= form.text_field :name, required: true, placeholder: 'Введите имя пользователя' %>
      </div>

      <div class="auth-form-group">
        <%= form.label :password, "Пароль" %>
        <%= form.password_field :password, required: true, placeholder: 'Введите пароль' %>
      </div>

      <div class="auth-form-group">
        <%= form.label :password_confirmation, "Подтверждение пароля" %>
        <%= form.password_field :password_confirmation, required: true, placeholder: 'Повторите пароль' %>
      </div>

      <%= form.submit "Создать аккаунт", class: 'auth-btn' %>
    <% end %>

    <div class="auth-footer">
      Уже зарегистрированы? <%= link_to "Войти", login_path %>
    </div>
  </div>
</div>
