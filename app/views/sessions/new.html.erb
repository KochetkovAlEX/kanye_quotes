<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">Вход в систему</h1>

    <% if flash[:alert] %>
      <div class="alert alert-danger"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with url: login_path, method: :post, local: true do |form| %>
      <div class="auth-form-group">
        <%= label_tag :name, 'Имя пользователя' %>
        <%= text_field_tag :name, params[:name], required: true, placeholder: 'Введите имя' %>
      </div>

      <div class="auth-form-group">
        <%= label_tag :password, 'Пароль' %>
        <%= password_field_tag :password, nil, required: true, placeholder: 'Введите пароль' %>
      </div>

      <%= submit_tag 'Войти', class: 'auth-btn' %>
    <% end %>

    <div class="auth-footer">
      Нет аккаунта? <%= link_to 'Зарегистрироваться', signup_path %>
    </div>
  </div>
</div>
